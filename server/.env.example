# ==========================================
# AMS HACKATHON 2026 - ENVIRONMENT CONFIG
# ==========================================

# 1. MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ams_hackathon_2026?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/ams_hackathon_2026?retryWrites=true&w=majority

# 2. Server Port
PORT=5000
NODE_ENV=development

# 3. Admin & Security Secrets
JWT_SECRET=ams_hackathon_super_secret_jwt_key_2026
ADMIN_SECRET_KEY=ams_admin_key_2026

# 4. Razorpay Payment Gateway Credentials (Optional / Production)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# 5. Email Notifications (Optional / Nodemailer SMTP — free Gmail App Password works)
# Enable 2FA on the sender Gmail, create an App Password, and put it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=amshackathon2026@gmail.com
SMTP_PASS=your_gmail_app_password

# 6. Hardware PS Release (optional override for testing; default = 2026-08-19T11:01:00+05:30)
# PS_REVEAL_TIMESTAMP=1784530860000
